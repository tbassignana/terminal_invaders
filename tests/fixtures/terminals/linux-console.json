{
  "family": "linux-console",
  "provenance": "synthetic: the Linux virtual console in UTF-8 mode; the probe skips DECRQM, XTVERSION and OSC 11; built from the terminal-capabilities audit (eval.json) and its cited sources; replace with an invaders --probe --raw capture (G5)",
  "env": {
    "TERM": "linux",
    "LANG": "en_US.UTF-8"
  },
  "replies": "\u001b[2;1R\u001b[3;2R\u001b[0n\u001b[?6c",
  "push_reply": null,
  "echo": false,
  "keys": {
    "protocol": "legacy",
    "os_repeat": {
      "delay": 0.25,
      "interval": 0.033
    }
  },
  "expect": {
    "family": "linux",
    "remote": false,
    "multiplexer": null,
    "color": "16",
    "background": "dark",
    "sync": false,
    "release_events": false,
    "scheme": "latched",
    "utf8": true,
    "ambiguous_wide": false,
    "unicode_blocks": true,
    "echoes_queries": false,
    "ack": "cpr"
  }
}
